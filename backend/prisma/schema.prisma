// Prisma Schema for Read Academy Sahiwal (Node.js + PostgreSQL)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
}

enum FeeStatus {
  PAID
  PENDING
  OVERDUE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ExamStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

enum PaymentStatus {
  PAID
  PENDING
  PROCESSING
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum NoticePriority {
  NORMAL
  HIGH
  URGENT
}

// -------------------------------------------------------------
// 1. AUTHENTICATION & USERS
// -------------------------------------------------------------

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String      @map("password_hash")
  fullName     String      @map("full_name")
  phone        String?     @unique
  role         UserRole    @default(STUDENT)
  avatarUrl    String?     @map("avatar_url")
  status       UserStatus  @default(ACTIVE)
  lastLogin    DateTime?   @map("last_login")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  // Relationships
  sessions       UserSession[]
  adminProfile   AdminProfile?
  studentProfile Student?
  teacherProfile Teacher?
  blogPosts      BlogPost[]
  notices        Notice[]
  transactions   AccountTransaction[]

  @@map("users")
}

model AdminProfile {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  empId            String   @unique @map("emp_id") // e.g. "ADM-001"
  designation      String   // e.g. "Campus Director", "Principal", "Accountant", "Registrar"
  department       String   @default("Administration") // e.g. "Executive", "Accounts", "IT Operations"
  permissions      String[] // e.g. ["ALL"] or ["MANAGE_STUDENTS", "MANAGE_FEES", "MANAGE_TEACHERS"]
  isSuperAdmin     Boolean  @default(false) @map("is_super_admin")
  emergencyContact String?  @map("emergency_contact")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

// -------------------------------------------------------------
// 2. ACADEMIC STRUCTURE (Classes, Sections, Subjects)
// -------------------------------------------------------------

model Class {
  id           String   @id @default(uuid())
  name         String   @unique // e.g. "Grade 9"
  numericLevel Int      @map("numeric_level")
  capacity     Int      @default(40)
  createdAt    DateTime @default(now()) @map("created_at")

  sections            Section[]
  students            Student[]
  classSubjects       ClassSubject[]
  timetables          TimetableSlot[]
  homeworkAssignments HomeworkItem[]
  admissions          AdmissionApplication[]
  dateSheets          DateSheetItem[]

  @@map("classes")
}

model Section {
  id             String   @id @default(uuid())
  classId        String   @map("class_id")
  name           String   // e.g. "Section A - Rose"
  roomNumber     String?  @map("room_number")
  classTeacherId String?  @map("class_teacher_id")
  createdAt      DateTime @default(now()) @map("created_at")

  class               Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  classTeacher        Teacher?       @relation("SectionClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  students            Student[]
  classSubjects       ClassSubject[]
  timetables          TimetableSlot[]
  homeworkAssignments HomeworkItem[]

  @@unique([classId, name])
  @@map("sections")
}

model Subject {
  id            String   @id @default(uuid())
  code          String   @unique // e.g. "PHY-09"
  name          String   // e.g. "Physics"
  department    String   // e.g. "Science"
  weeklyPeriods Int      @default(5) @map("weekly_periods")
  createdAt     DateTime @default(now()) @map("created_at")

  classSubjects       ClassSubject[]
  timetables          TimetableSlot[]
  marksEntries        MarksEntry[]
  dateSheets          DateSheetItem[]
  homeworkAssignments HomeworkItem[]

  @@map("subjects")
}

model ClassSubject {
  id            String @id @default(uuid())
  classId       String @map("class_id")
  sectionId     String @map("section_id")
  subjectId     String @map("subject_id")
  teacherId     String @map("teacher_id")
  weeklyPeriods Int    @default(5) @map("weekly_periods")

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, sectionId, subjectId])
  @@map("class_subjects")
}

// -------------------------------------------------------------
// 3. STUDENTS
// -------------------------------------------------------------

model Student {
  id               String    @id @default(uuid())
  userId           String?   @unique @map("user_id")
  rollNo           String    @unique @map("roll_no") // e.g. "RAS-2026-89"
  admissionNo      String?   @unique @map("admission_no")
  fullName         String    @map("full_name")
  avatarUrl        String?   @map("avatar_url")
  gender           Gender
  dob              DateTime
  bloodGroup       String?   @map("blood_group")
  classId          String    @map("class_id")
  sectionId        String    @map("section_id")
  parentName       String    @map("parent_name")
  parentPhone      String    @map("parent_phone")
  parentEmail      String?   @map("parent_email")
  emergencyContact String?   @map("emergency_contact")
  homeAddress      String    @map("home_address")
  admissionDate    DateTime  @default(now()) @map("admission_date")
  previousSchool   String?   @map("previous_school")
  feeStatus        FeeStatus @default(PENDING) @map("fee_status")
  status           String    @default("Active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  class               Class                @relation(fields: [classId], references: [id])
  section             Section              @relation(fields: [sectionId], references: [id])
  attendance          StudentAttendance[]
  feeVouchers         FeeVoucher[]
  marksEntries        MarksEntry[]
  homeworkSubmissions HomeworkSubmission[]

  @@index([rollNo, classId, sectionId])
  @@map("students")
}

// -------------------------------------------------------------
// 4. ADMISSIONS
// -------------------------------------------------------------

model AdmissionApplication {
  id                 String            @id @default(uuid())
  applicationNo      String            @unique @map("application_no")
  studentName        String            @map("student_name")
  appliedClassId     String            @map("applied_class_id")
  gender             Gender
  dob                DateTime
  parentName         String            @map("parent_name")
  parentPhone        String            @map("parent_phone")
  parentEmail        String?           @map("parent_email")
  homeAddress        String            @map("home_address")
  previousSchool     String?           @map("previous_school")
  previousPercentage Decimal?          @map("previous_percentage") @db.Decimal(5, 2)
  status             ApplicationStatus @default(PENDING)
  documentsSubmitted Json?             @map("documents_submitted")
  adminNotes         String?           @map("admin_notes")
  applicationDate    DateTime          @default(now()) @map("application_date")

  appliedClass Class @relation(fields: [appliedClassId], references: [id])

  @@map("admission_applications")
}

// -------------------------------------------------------------
// 5. TEACHERS & FACULTY
// -------------------------------------------------------------

model Teacher {
  id              String   @id @default(uuid())
  userId          String?  @unique @map("user_id")
  empId           String   @unique @map("emp_id") // e.g. "T-101"
  fullName        String   @map("full_name")
  avatarUrl       String?  @map("avatar_url")
  department      String
  specialization  String
  qualification   String
  experienceYears Int      @default(1) @map("experience_years")
  phone           String
  email           String   @unique
  joiningDate     DateTime @map("joining_date")
  basicSalary     Decimal  @map("basic_salary") @db.Decimal(10, 2)
  bankAccountNo   String?  @map("bank_account_no")
  status          String   @default("Active")
  createdAt       DateTime @default(now()) @map("created_at")

  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  classSubjects       ClassSubject[]
  sectionsInCharge    Section[]            @relation("SectionClassTeacher")
  duties              TeacherDuty[]
  payrollRecords      PayrollRecord[]
  attendance          TeacherAttendance[]
  timetables          TimetableSlot[]
  homeworkAssignments HomeworkItem[]
  dateSheets          DateSheetItem[]

  @@map("teachers")
}

model TeacherDuty {
  id           String   @id @default(uuid())
  teacherId    String   @map("teacher_id")
  dutyTitle    String   @map("duty_title")
  description  String?
  assignedDate DateTime @map("assigned_date")
  status       String   @default("Active")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("teacher_duties")
}

model PayrollRecord {
  id             String        @id @default(uuid())
  teacherId      String        @map("teacher_id")
  monthYear      String        @map("month_year") // e.g. "September 2026"
  basicSalary    Decimal       @map("basic_salary") @db.Decimal(10, 2)
  allowances     Decimal       @default(0.00) @db.Decimal(10, 2)
  deductions     Decimal       @default(0.00) @db.Decimal(10, 2)
  tax            Decimal       @default(0.00) @db.Decimal(10, 2)
  netSalary      Decimal       @map("net_salary") @db.Decimal(10, 2)
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")
  paymentDate    DateTime?     @map("payment_date")
  transactionRef String?       @map("transaction_ref")
  createdAt      DateTime      @default(now()) @map("created_at")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, monthYear])
  @@map("payroll_records")
}

// -------------------------------------------------------------
// 6. ATTENDANCE & TIMETABLE
// -------------------------------------------------------------

model StudentAttendance {
  id        String           @id @default(uuid())
  studentId String           @map("student_id")
  date      DateTime         @default(now()) @db.Date
  status    AttendanceStatus
  remarks   String?
  smsSent   Boolean          @default(false) @map("sms_sent")
  createdAt DateTime         @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([date, status])
  @@map("student_attendance")
}

model TeacherAttendance {
  id        String           @id @default(uuid())
  teacherId String           @map("teacher_id")
  date      DateTime         @default(now()) @db.Date
  checkIn   String?          @map("check_in")
  checkOut  String?          @map("check_out")
  status    AttendanceStatus

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date])
  @@map("teacher_attendance")
}

model TimetableSlot {
  id           String @id @default(uuid())
  classId      String @map("class_id")
  sectionId    String @map("section_id")
  dayOfWeek    String @map("day_of_week") // Monday - Saturday
  periodNumber Int    @map("period_number")
  startTime    String @map("start_time")
  endTime      String @map("end_time")
  subjectId    String @map("subject_id")
  teacherId    String @map("teacher_id")
  roomNumber   String @map("room_number")

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@unique([classId, sectionId, dayOfWeek, periodNumber])
  @@map("timetable_slots")
}

// -------------------------------------------------------------
// 7. EXAMINATIONS & MARKS
// -------------------------------------------------------------

model Exam {
  id           String     @id @default(uuid())
  title        String
  term         String     // e.g. "Mid-Term", "Annual BISE Pre-Board"
  academicYear String     @map("academic_year")
  startDate    DateTime   @map("start_date")
  endDate      DateTime   @map("end_date")
  status       ExamStatus @default(UPCOMING)
  createdAt    DateTime   @default(now()) @map("created_at")

  dateSheets   DateSheetItem[]
  marksEntries MarksEntry[]

  @@map("exams")
}

model DateSheetItem {
  id            String @id @default(uuid())
  examId        String @map("exam_id")
  classId       String @map("class_id")
  subjectId     String @map("subject_id")
  examDate      DateTime @map("exam_date") @db.Date
  dayName       String @map("day_name")
  startTime     String @map("start_time")
  endTime       String @map("end_time")
  roomNumber    String @map("room_number")
  invigilatorId String? @map("invigilator_id")

  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  class       Class    @relation(fields: [classId], references: [id])
  subject     Subject  @relation(fields: [subjectId], references: [id])
  invigilator Teacher? @relation(fields: [invigilatorId], references: [id])

  @@map("exam_datesheets")
}

model MarksEntry {
  id            String   @id @default(uuid())
  examId        String   @map("exam_id")
  studentId     String   @map("student_id")
  subjectId     String   @map("subject_id")
  totalMarks    Decimal  @default(100.00) @map("total_marks") @db.Decimal(5, 2)
  obtainedMarks Decimal  @map("obtained_marks") @db.Decimal(5, 2)
  grade         String
  remarks       String?
  createdAt     DateTime @default(now()) @map("created_at")

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([examId, studentId, subjectId])
  @@map("marks_entries")
}

// -------------------------------------------------------------
// 8. HOMEWORK
// -------------------------------------------------------------

model HomeworkItem {
  id            String   @id @default(uuid())
  title         String
  description   String?
  classId       String   @map("class_id")
  sectionId     String?  @map("section_id")
  subjectId     String   @map("subject_id")
  teacherId     String   @map("teacher_id")
  assignedDate  DateTime @default(now()) @map("assigned_date") @db.Date
  dueDate       DateTime @map("due_date") @db.Date
  attachmentUrl String?  @map("attachment_url")
  status        String   @default("Active")

  class       Class                @relation(fields: [classId], references: [id])
  section     Section?             @relation(fields: [sectionId], references: [id])
  subject     Subject              @relation(fields: [subjectId], references: [id])
  teacher     Teacher              @relation(fields: [teacherId], references: [id])
  submissions HomeworkSubmission[]

  @@map("homework_items")
}

model HomeworkSubmission {
  id              String   @id @default(uuid())
  homeworkId      String   @map("homework_id")
  studentId       String   @map("student_id")
  submissionText  String?  @map("submission_text")
  attachmentUrl   String?  @map("attachment_url")
  submittedAt     DateTime @default(now()) @map("submitted_at")
  status          String   @default("Submitted")
  teacherFeedback String?  @map("teacher_feedback")
  marksObtained   Decimal? @map("marks_obtained") @db.Decimal(5, 2)

  homework HomeworkItem @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
  @@map("homework_submissions")
}

// -------------------------------------------------------------
// 9. FEES & FINANCIAL TRANSACTIONS
// -------------------------------------------------------------

model FeeVoucher {
  id             String    @id @default(uuid())
  voucherNo      String    @unique @map("voucher_no") // e.g. "VCH-2026-09-001"
  studentId      String    @map("student_id")
  billingMonth   String    @map("billing_month")
  tuitionFee     Decimal   @map("tuition_fee") @db.Decimal(10, 2)
  examFee        Decimal   @default(0.00) @map("exam_fee") @db.Decimal(10, 2)
  labFee         Decimal   @default(0.00) @map("lab_fee") @db.Decimal(10, 2)
  utilityCharges Decimal   @default(0.00) @map("utility_charges") @db.Decimal(10, 2)
  lateFine       Decimal   @default(0.00) @map("late_fine") @db.Decimal(10, 2)
  totalAmount    Decimal   @map("total_amount") @db.Decimal(10, 2)
  dueDate        DateTime  @map("due_date") @db.Date
  paidDate       DateTime? @map("paid_date") @db.Date
  status         FeeStatus @default(PENDING)
  paymentMethod  String?   @map("payment_method")
  createdAt      DateTime  @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([status, billingMonth])
  @@map("fee_vouchers")
}

model AccountTransaction {
  id              String          @id @default(uuid())
  transactionDate DateTime        @default(now()) @map("transaction_date") @db.Date
  title           String
  type            TransactionType
  category        String          // e.g. "Tuition Fees", "Faculty Salaries", "Campus Utilities"
  amount          Decimal         @db.Decimal(12, 2)
  referenceNo     String?         @map("reference_no")
  recordedById    String?         @map("recorded_by_id")
  createdAt       DateTime        @default(now()) @map("created_at")

  recordedBy User? @relation(fields: [recordedById], references: [id])

  @@index([transactionDate, type])
  @@map("account_transactions")
}

// -------------------------------------------------------------
// 10. NOTICES & CMS
// -------------------------------------------------------------

model Notice {
  id            String         @id @default(uuid())
  title         String
  content       String
  category      String
  priority      NoticePriority @default(NORMAL)
  audience      String         @default("All")
  publishedById String?        @map("published_by_id")
  pinned        Boolean        @default(false)
  publishedDate DateTime       @default(now()) @map("published_date") @db.Date
  createdAt     DateTime       @default(now()) @map("created_at")

  publishedBy User? @relation(fields: [publishedById], references: [id])

  @@map("notices")
}

model BlogPost {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  excerpt       String?
  content       String
  category      String
  tags          String[]
  authorId      String?  @map("author_id")
  featuredImage String?  @map("featured_image")
  viewsCount    Int      @default(0) @map("views_count")
  status        String   @default("Published")
  publishedAt   DateTime @default(now()) @map("published_at")

  author User? @relation(fields: [authorId], references: [id])

  @@map("blog_posts")
}

model GalleryAlbum {
  id        String   @id @default(uuid())
  title     String
  category  String
  coverUrl  String?  @map("cover_url")
  eventDate DateTime? @map("event_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  images GalleryImage[]

  @@map("gallery_albums")
}

model GalleryImage {
  id        String   @id @default(uuid())
  albumId   String   @map("album_id")
  imageUrl  String   @map("image_url")
  caption   String?
  sortOrder Int      @default(0) @map("sort_order")

  album GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@map("gallery_images")
}

model SchoolEvent {
  id          String     @id @default(uuid())
  title       String
  category    String     // "Sports", "Academic", "Cultural"
  eventDate   DateTime   @map("event_date") @db.Date
  eventTime   String?    @map("event_time")
  location    String?
  description String?
  bannerImage String?    @map("banner_image")
  isPublic    Boolean    @default(true) @map("is_public")
  status      ExamStatus @default(UPCOMING)

  @@map("school_events")
}

model ContactInquiry {
  id        String   @id @default(uuid())
  fullName  String   @map("full_name")
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("New")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_inquiries")
}
